export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"

_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)  fzf --preview "eza --tree --color=always {} | head -200" "$@" ;;
    export|unset)  fzf --preview "eval 'echo \${}'" "$@" ;;
    ssh)  fzf --preview "dig {}" "$@" ;;
    *)  fzf --preview 'bat -n --color=always --line-range :500 {}' "$@" ;;
  esac
}

############################################
# Start of fzf-tab
############################################
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' single-group color header
zstyle ':fzf-tab:*' fzf-min-height 20
zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --border=rounded \
  --preview-window=right:60%:wrap --bind=ctrl-/:toggle-preview \
  --bind=ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down

zstyle ':fzf-tab:complete:git(|-*):*' fzf-preview \
  'ref=$word
   git rev-parse --verify --quiet "$ref" >/dev/null 2>&1 ||
     ref=$(git for-each-ref --count=1 --format="%(refname:short)" "refs/remotes/*/$word")
   [[ -n $ref ]] && git log --graph --color=always --date=short \
     --pretty=format:"%C(auto)%h %C(blue)%ad%C(auto)%d %s %C(brightblack)<%an>" \
     "$ref" -- 2>/dev/null | head -200'
############################################
# End of fzf-tab
############################################

